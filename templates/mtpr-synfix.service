[Unit]
Description=MTProto SYN FIX rules for Telemt (MEKO v3)
After=network.target ufw.service
Wants=ufw.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/mtpr-synfix
ExecStart=/opt/mtpr-simple/apply-mtpr-synfix.sh
Restart=on-failure

[Install]
WantedBy=multi-user.target
